# Copy to .env and fill in what you need. Every variable is optional: with no .env at all the
# studio runs offline with mock providers and an in-memory store.

# Gemini API key: the director (story bible), the story lock pass and the poster. Live mode only.
GOOGLE_API_KEY=
# fal.ai API key: one text-to-video clip per scene. Live mode only.
FAL_KEY=

# MongoDB connection string. Leave empty to keep films in memory (lost on restart).
# `docker compose up -d mongo` starts a local MongoDB that matches this value.
MONGO_URI=mongodb://localhost:27017/aiflix-studio

# API server address. Keep 127.0.0.1: the studio has no authentication.
HOST=127.0.0.1
PORT=3001

# Folder for generated clips, films, posters and plan snapshots. Default: ./generated
GENERATED_DIR=

# Gemini model for the director and the story lock. Default: gemini-2.5-flash
STUDIO_SCRIPT_MODEL=
# Gemini image model for the poster. Default: gemini-2.5-flash-image
STUDIO_POSTER_MODEL=

# "mock" (default when empty): offline placeholder story, clips and poster, no keys needed.
# "live": Gemini and fal.ai, which are paid API calls.
STUDIO_PROVIDERS=

# Films that may render at the same time. Default: 1
STUDIO_MAX_CONCURRENT_JOBS=
# Most clips (paid video calls) one film may use. Default: 12, which allows up to 174 seconds.
STUDIO_MAX_CLIPS_PER_JOB=

# Text on the end card. Default: AIFLIX Studio
STUDIO_END_CARD_TEXT=

# ffmpeg and ffprobe executables. Default: found on PATH
FFMPEG_PATH=
FFPROBE_PATH=
